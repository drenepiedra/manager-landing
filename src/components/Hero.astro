---
---

<section class="relative min-h-screen flex items-center justify-center overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-br from-primary-600/20 via-dark-950 to-dark-950"></div>
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-primary-500/10 via-transparent to-transparent"></div>

  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-px h-32 border-l border-dashed border-dark-700"></div>
  <div class="absolute top-20 left-[15%] w-px h-48 border-l border-dashed border-dark-800 hidden lg:block"></div>
  <div class="absolute top-32 right-[15%] w-px h-40 border-l border-dashed border-dark-800 hidden lg:block"></div>
  <div class="absolute top-1/3 left-0 w-32 h-px border-t border-dashed border-dark-800 hidden lg:block"></div>
  <div class="absolute top-1/3 right-0 w-32 h-px border-t border-dashed border-dark-800 hidden lg:block"></div>
  <div class="absolute bottom-32 left-[25%] w-24 h-px border-t border-dashed border-dark-700 hidden lg:block"></div>
  <div class="absolute bottom-40 right-[25%] w-24 h-px border-t border-dashed border-dark-700 hidden lg:block"></div>

  <div class="absolute top-20 left-[15%] w-2 h-2 rounded-full bg-dark-700 hidden lg:block"></div>
  <div class="absolute top-32 right-[15%] w-2 h-2 rounded-full bg-dark-700 hidden lg:block"></div>
  <div class="absolute top-1/3 left-32 w-1.5 h-1.5 rounded-full bg-primary-500/30 hidden lg:block"></div>
  <div class="absolute top-1/3 right-32 w-1.5 h-1.5 rounded-full bg-primary-500/30 hidden lg:block"></div>
  
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <div class="space-y-8">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-primary-500/10 border border-dashed border-primary-500/30 text-primary-400 text-sm font-medium">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
        </svg>
        Predicciones Deportivas
      </div>
      
      <h1 class="text-5xl sm:text-6xl lg:text-7xl font-bold tracking-tight">
        <span class="block text-white">Predice el Resultado</span>
        <span class="block mt-2 bg-gradient-to-r from-primary-400 to-primary-600 bg-clip-text text-transparent">
          Gana con tu Conocimiento
        </span>
      </h1>
      
      <p class="max-w-2xl mx-auto text-xl text-dark-300 leading-relaxed">
        La app definitiva para predicciones de pelota. Analiza, predice y compite con otros aficionados del deporte en tiempo real.
      </p>
      
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center pt-4">
        <a href="#features" class="group px-8 py-4 bg-primary-600 hover:bg-primary-700 text-white font-semibold rounded-xl transition-all duration-200 shadow-lg shadow-primary-500/25 hover:shadow-primary-500/40 hover:-translate-y-0.5">
          Descubrir Más
          <svg class="inline-block ml-2 w-5 h-5 group-hover:translate-y-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
          </svg>
        </a>
        <a href="#gallery" class="px-8 py-4 bg-dark-800 hover:bg-dark-700 text-white font-semibold rounded-xl border border-dashed border-dark-600 hover:border-dark-500 transition-all duration-200 hover:-translate-y-0.5">
          Ver Galería
        </a>
      </div>
    </div>
  </div>
  
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
    <svg class="w-6 h-6 text-dark-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
    </svg>
  </div>
</section>
